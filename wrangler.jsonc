{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vahid-web-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "09033b33-df40-477a-9ea0-d3349b1053ab","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "bfaa5e1f7e9740ff871e89227fd189b3" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
